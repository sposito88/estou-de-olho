# Banco SQLite. Caminho relativo é resolvido a partir da pasta de execução;
# se omitido, usa gastos-camara/data/gastos.db.
DATABASE_URL=sqlite:///data/gastos.db

# API de Dados Abertos da Câmara
API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
BULK_URL_TEMPLATE=https://www.camara.leg.br/cotas/Ano-{ano}.csv.zip
ID_LEGISLATURA=57

# Anos coletados por padrão (lista separada por vírgula). Se omitido: 2023 até o ano corrente.
ANOS=2023,2024,2025,2026

# Portal da Transparência (emendas parlamentares). Chave grátis e pessoal:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_URL=https://api.portaldatransparencia.gov.br/api-de-dados
TRANSPARENCIA_API_KEY=
EMENDAS_BULK_URL=https://portaldatransparencia.gov.br/download-de-dados/emendas-parlamentares/UNICO

# Limites do cliente HTTP
REQ_PER_SEC=4
TIMEOUT=30
ITENS_POR_PAGINA=100

# URL pública da FastAPI (o front React em web/ lê a sua própria VITE_API_URL)
API_URL=http://localhost:8000

LOG_LEVEL=INFO

# Endereço público do site (usado nos links dos avisos)
SITE_URL=http://localhost:5173

# Avisos no Telegram de novos pagamentos de emenda (opcional).
# Crie um bot com o @BotFather e pegue o chat_id do grupo/canal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MUNICIPIOS_MONITORADOS=PE/Carpina

# Pernambuco: municípios cujas contas (prefeitura e câmara) vêm do TCE-PE
TCE_MUNICIPIOS=Carpina

# São Paulo: despesas municipais do TCE-SP ("todos" ou lista de nomes; a capital não está no TCE-SP)
TCE_SP_MUNICIPIOS=todos
TCE_SP_REQ_PER_SEC=2
ALEPE_REQ_PER_SEC=2
